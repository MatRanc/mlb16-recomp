#version 450

// c690 0xA730 heavy-body leaf (SPU LS 0xB830) -- batched burst kernel.
//
// Transliterated from the lifted body
//   jobmod_c690c2f7b09a_eF5B8_spu_func_0000B830_body()
// (recomp-work/spu_lifted/jobmod_c690c2f7b09a_eF5B8/spu_recomp.c).  The leaf is
// a 78-line, four-vertex transform/normalize slice: 5 x 16-byte LS reads,
// 4 x 16-byte LS writes, 25 shufb, 22 selb, 9 fma, 2 rotqby, 3 addi + 1 add.
//
// Encoding: the Local Store is uploaded as its raw little-endian 32-bit words;
// every SPU word is byte-swapped into the big-endian logical value the lifted
// code sees.  A uvec4 is one SPU 128-bit register, component 0 = preferred
// slot.  shufb/rotqby work on SPU byte positions (byte P of word w is
// w >> (24 - 8*(P&3))).
//
// Float semantics: SPU_FAST_FLOAT (build-play) = FTZ operands/results + fused
// single-precision FMA.  ftz() is the lifted module's rule: exponent == 0
// (denormal or zero) becomes +0; fma() is GLSL.std.450 Fma (no intermediate
// rounding).
//
// Work mapping: one invocation per leaf call.  Job J reads pair (J % npairs)
// and writes that same pair's LS image; the exactness run uses npairs == J.
//
// Bindings:
//   0  in_words[]   npairs * 65536 u32   (raw LS images)
//   1  out_words[]  npairs * 65536 u32   (LS after the leaf writes)
//   2  gpr_words[]  npairs * 512 u32     (128 registers x 4 words, raw)
// Push constants: job_count, npairs, ls_words, pad.

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(std430, binding = 0) readonly buffer InputBuffer  { uint in_words[];  };
layout(std430, binding = 1) buffer OutputBuffer { uint out_words[]; };
layout(std430, binding = 2) readonly buffer GprBuffer { uint gpr_words[]; };
layout(std430, binding = 3) buffer GprOutBuffer { uint out_gpr_words[]; };

layout(push_constant) uniform PushConstants {
    uint job_count;
    uint npairs;
    uint ls_words;
    uint pad0;
} pc;

uint bswap32(uint v)
{
    return (v >> 24u) | ((v >> 8u) & 0x0000FF00u) |
           ((v << 8u) & 0x00FF0000u) | (v << 24u);
}

uint pair_base;
uint out_base;

uvec4 load_gpr(uint n)
{
    // The captured GPR image is a host u128 array: each 32-bit word is already
    // the SPU register word value (no Local Store byte order involved).
    uint b = pair_base * 512u + n * 4u;
    return uvec4(gpr_words[b + 0u], gpr_words[b + 1u],
                 gpr_words[b + 2u], gpr_words[b + 3u]);
}

uvec4 load128(uint lsa)
{
    uint a = (lsa & 0x3FFF0u) >> 2u;
    uint b = pair_base * pc.ls_words + a;
    return uvec4(bswap32(in_words[b + 0u]), bswap32(in_words[b + 1u]),
                 bswap32(in_words[b + 2u]), bswap32(in_words[b + 3u]));
}

// The leaf also leaves nine GPRs live for the caller (0xA660 overwrites
// gpr[0] and gpr[80..127] from LS, so only these nine survive the tail call).
void store_gpr(uint n, uvec4 v)
{
    uint b = out_base * 512u + n * 4u;
    out_gpr_words[b + 0u] = v.x;
    out_gpr_words[b + 1u] = v.y;
    out_gpr_words[b + 2u] = v.z;
    out_gpr_words[b + 3u] = v.w;
}

void store128(uint lsa, uvec4 v)
{
    uint a = (lsa & 0x3FFF0u) >> 2u;
    uint b = out_base * pc.ls_words + a;
    out_words[b + 0u] = bswap32(v.x);
    out_words[b + 1u] = bswap32(v.y);
    out_words[b + 2u] = bswap32(v.z);
    out_words[b + 3u] = bswap32(v.w);
}

// SPU byte P of a register (big-endian word layout).
uint getb(uvec4 r, uint p)
{
    uint w = r[p >> 2u];
    return (w >> (24u - 8u * (p & 3u))) & 0xFFu;
}

uvec4 setb(uvec4 r, uint p, uint v)
{
    uint wi = p >> 2u;
    uint sh = 24u - 8u * (p & 3u);
    uint m = 0xFFu << sh;
    uint w = r[wi];
    w = (w & ~m) | ((v & 0xFFu) << sh);
    r[wi] = w;
    return r;
}

uvec4 selb4(uvec4 a, uvec4 b, uvec4 c)
{
    return (a & ~c) | (b & c);
}

uvec4 shufb4(uvec4 a, uvec4 b, uvec4 c)
{
    uvec4 r = uvec4(0u);
    for (uint t = 0u; t < 16u; ++t) {
        uint s = getb(c, t);
        uint v;
        if ((s & 0xE0u) == 0xE0u)      v = 0x80u;
        else if ((s & 0xC0u) == 0xC0u) v = 0xFFu;
        else if ((s & 0xC0u) == 0x80u) v = 0x00u;
        else {
            uint p = s & 0x1Fu;
            v = (p < 16u) ? getb(a, p) : getb(b, p - 16u);
        }
        r = setb(r, t, v);
    }
    return r;
}

float ftz(float v)
{
    uint u = floatBitsToUint(v);
    if ((u & 0x7F800000u) == 0u)
        return 0.0;
    return v;
}

uvec4 fma4(uvec4 a, uvec4 b, uvec4 c)
{
    uvec4 r;
    for (uint i = 0u; i < 4u; ++i) {
        float x = ftz(uintBitsToFloat(a[i]));
        float y = ftz(uintBitsToFloat(b[i]));
        float z = ftz(uintBitsToFloat(c[i]));
        r[i] = floatBitsToUint(ftz(fma(x, y, z)));
    }
    return r;
}

uvec4 rotqby(uvec4 a, uvec4 b)
{
    uint sh = b.x & 0x0Fu;
    uvec4 r = uvec4(0u);
    for (uint t = 0u; t < 16u; ++t)
        r = setb(r, t, getb(a, (t + sh) & 0x0Fu));
    return r;
}

